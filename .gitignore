# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Runtime data ──────────────────────────────────────────────────────────────
# Everything under data/runs/ and data/uploads/ is GENERATED by an analysis and
# can be rebuilt from the uploaded video. Never commit it.
data/runs/
data/uploads/

# Generated fixtures. data/samples/full_fixture.mp4 is rebuilt by
#   python scripts/dataset/build_test_fixture.py
data/samples/

# ── Datasets ──────────────────────────────────────────────────────────────────
# data/datasets/source_clips/ is the approved 41-clip evaluation set. It is a
# curated, checksummed dataset rather than build output, so it IS tracked; the
# checksum manifest next to it must be committed with it.
!data/datasets/
!data/datasets/source_clips/
!data/manifests/



# ── Secrets and local overrides ───────────────────────────────────────────────
.env
.env.*
!.env.example

